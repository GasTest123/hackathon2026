# Which LLM backend to expose through /v1/chat/completions.
# Supported values: garena | openai
LLM_PROVIDER=garena

# HTTP server port
PORT=3000

# HTTP server prefix
PREFIX=/api

# Optional API key required from clients calling /v1/*. When unset the API
# accepts JWT access tokens only. When set, this key is also accepted.
SERVER_API_KEY=hackathon2026

# Secret used to sign and verify user access-token JWTs.
# May be empty for local development. Change to a strong secret in production.
JWT_SECRET=hackathon2026

# Directory used by /profile and /resource storage. Set this to /data when a
# persistent volume is mounted there in production.
DATA_DIR=./data

# System prompt template file. Relative to the backend cwd.
# The file is re-read for every chat request. Use {{system}} to inject the
# system content from the API request.
SYSTEM_PROMPT_FILE=./prompts/system.md

# ---------- Garena AI Agent Hackathon 2026 ----------
GARENA_API_ORIGIN=https://aiagenthackathon2026.sh.jingle.cn/
GARENA_BASE_URL=/api/v1
GARENA_CLIENT_ID=
GARENA_CLIENT_SECRET=
GARENA_MODEL=doubao-1-5-pro-32k-character
# Garena upstream gRPC timeout is 600s. Keep client timeout >= 600000.
GARENA_HTTP_TIMEOUT_MS=620000
# File path used to persist the Access Token across restarts. Relative to
# the backend cwd. Stored with mode 0600.
GARENA_TOKEN_CACHE_FILE=.cache/garena-access-token.json

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_HTTP_TIMEOUT_MS=60000
# Optional org/project headers
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
